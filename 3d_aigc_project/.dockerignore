# ==========================================
# Docker忽略文件
# ==========================================

# Git相关
.git
.gitignore

# IDE配置
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 环境变量文件
.env
.env.local
.env.*.local

# Python相关
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.egg

# Node.js相关
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 前端构建产物（Docker内构建，不需要复制）
frontend/dist/
frontend/node_modules/

# 模型文件（体积过大，通过volume挂载）
models/

# 输出和上传文件
outputs/
uploads/

# 文档
*.md
LICENSE

# Docker相关
docker-compose*.yml
.dockerignore
