# ==========================================
# 环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改
# ==========================================

# ---------- GPU配置 ----------
# GPU显存大小（GB），用于自动选择模型版本
GPU_MEMORY_GB=8

# ---------- 模型配置 ----------
# 模型版本：auto（自动）/ mini / standard / turbo
MODEL_VERSION=auto

# ---------- 路径配置 ----------
# 镶嵌结构数据库路径（相对或绝对路径）
INLAY_DB_PATH=../镶嵌结构数据库

# ---------- 服务地址 ----------
# AI服务内部通信地址（Docker网络内）
AI_SERVICE_URL=http://ai-service:8855

# ---------- 端口配置 ----------
# 前端服务端口
FRONTEND_PORT=8853

# 业务服务端口
BUSINESS_SERVICE_PORT=8854

# AI服务端口
AI_SERVICE_PORT=8855

# ---------- 日志配置 ----------
# 日志级别：debug / info / warning / error
LOG_LEVEL=info
