# ==========================================
# 环境变量配置模板
# 复制为 .env 后按需修改：copy .env.example .env
# ==========================================

# ---------- Compose 模式 ----------
# 默认最小集（SQLite + 本地存储 + 内存队列），无需额外 profile
# 完整栈（PostgreSQL + MinIO + Redis）启动时使用 start.bat --full 或：
# COMPOSE_PROFILES=full
# SPRING_PROFILES_ACTIVE=docker,docker-full
COMPOSE_PROFILES=
SPRING_PROFILES_ACTIVE=docker

# ---------- GPU / 模型 ----------
# REQUIRE_GPU=1（默认）：CUDA 不可用则 ai-service 非零退出，禁止静默 CPU
# 紧急 CPU 请用 start.bat --cpu（会设 REQUIRE_GPU=0），勿手改后用于日常
REQUIRE_GPU=1
GPU_MEMORY_GB=16
GPU_COUNT=1
# mini | mv | standard | turbo | auto — 须与 models/ 下已下载权重一致（默认仓库含 mini+mv）
MODEL_VERSION=mv
OFFLINE_MODE=true
# ai-service：关闭本地 InstructPix2Pix（SAM 分割仍可用）
ENABLE_GEM_REPAINT=0
GEM_REPAINT_MODEL_PATH=./models/instruct-pix2pix
GEM_REPAINT_STRENGTH=0.45
GEM_REPAINT_MASK_DILATE=8
GEM_REPAINT_SEED=42

# business-service：通义万相云端去反光（DashScope）
DASHSCOPE_API_KEY=
# 默认北京 DashScope；若使用 Model Studio 业务空间密钥，填 CSV 中的 dashScope 地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
GEM_REPAINT_PROVIDER=wanx
GEM_REPAINT_PRIMARY_MODEL=wanx2.1-imageedit
GEM_REPAINT_FALLBACK_ENABLED=true
GEM_REPAINT_TIMEOUT_SECONDS=90
GEM_REPAINT_DEFAULT_PROMPT=去除宝石表面的镜面反光和过曝高光，使宝石呈现柔和漫反射效果，保持原有颜色、透明度和切面结构，不要改变金属爪镶、戒圈和背景。
TRACK_A_GEOMETRY_ONLY=true
CUDA_VISIBLE_DEVICES=0

# ---------- 宿主机路径（bind mount）----------
# 镶嵌结构 legacy 目录（只读挂载）
INLAY_DB_PATH=./镶嵌结构数据库
# Hunyuan3D / SAM 等模型目录（只读挂载，体积大，勿 COPY 进镜像）
MODELS_PATH=./models
UPLOADS_PATH=./uploads
OUTPUTS_PATH=./outputs

# ---------- 服务端口 ----------
FRONTEND_PORT=8853
BUSINESS_SERVICE_PORT=8854
AI_SERVICE_PORT=8855

# ---------- AI 并发（ai-service）----------
# 可同时处理的任务数（验证/后处理可并行）；GPU 推理实际串行为 1
MAX_CONCURRENT_TASKS=8
MAX_CONCURRENT_GPU_JOBS=1

# ---------- 基础设施（profile: full）----------
# full 模式下任务元数据存 PostgreSQL，输入/输出文件存 MinIO（generate-input / generate-output bucket）
POSTGRES_PORT=5432
POSTGRES_PASSWORD=jewelry
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
REDIS_PORT=6379

# ---------- JVM ----------
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+UseContainerSupport

# ---------- 日志 ----------
LOG_LEVEL=info
