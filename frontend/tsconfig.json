{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/pages/*"],
      "@utils/*": ["src/utils/*"],
      "@services/*": ["src/services/*"],
      "@stores/*": ["src/stores/*"],
      "@types/*": ["src/types/*"]
    }
  },
  "include": [
    "src/global.d.ts",
    "src/main/**/*",
    "src/renderer/**/*",
    "src/pages/**/*",
    "src/components/**/*",
    "src/services/**/*",
    "src/stores/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/shared/**/*"
  ],
  "exclude": ["node_modules", "dist", "src/index.tsx"]
}