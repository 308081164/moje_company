# 复制本文件为仓库根目录 `.env` 后填写（`.env` 已被 .gitignore 忽略，勿提交真实值）
# 本地 Docker：`docker compose --env-file .env -f docker-compose.dev.yml up -d`

# ========== 数据库 ==========
DB_PASSWORD=

# ========== JWT（长度建议 ≥32 字符）==========
JWT_SECRET=

# ========== 首次启动：种子管理员可登录密码 ==========
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_USERNAME=kuangjun

# ========== 阿里云 OSS（可选；不填则 OSS 上传能力关闭）==========
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 桶名：推荐 OSS_BUCKET_NAME；与 GitHub Secret「OSS_BUCKET」或旧文档一致时可使用 OSS_BUCKET
OSS_BUCKET_NAME=
OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_ENDPOINT=
# 镶嵌结构库在 OSS 中的前缀（与 scripts/upload_inlay_structure_library_to_oss.py 一致）
INLAY_STRUCTURE_OSS_PREFIX=inlay-structure-library/

# ========== 公网访问基址（按实际部署修改）==========
# 后端 API 对外基址（无路径），用于部分集成场景
JEWELRY_PUBLIC_BASE_URL=http://localhost:8851
# B2B + C 端客户进度统一门户（Vue，通常为 8852）。后端生成：
#   B2B: {JEWELRY_PORTAL_BASE_URL}/portal/b2b/order/{token}
#   C:   {JEWELRY_PORTAL_BASE_URL}/portal/c/progress/{token}
JEWELRY_PORTAL_BASE_URL=http://localhost:8852

# 可选：仅当 C 端进度页部署在与门户不同的域名时填写，否则留空以使用 JEWELRY_PORTAL_BASE_URL
# JEWELRY_CUSTOMER_ORDER_FRONTEND_URL=
