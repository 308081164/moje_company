# 复制本文件为仓库根目录 `.env` 后填写（`.env` 已被 .gitignore 忽略，勿提交真实值）
# 本地 Docker：`docker compose --env-file .env -f docker-compose.dev.yml up -d`

# ========== 数据库 ==========
DB_PASSWORD=

# ========== JWT（长度建议 ≥32 字符）==========
JWT_SECRET=

# ========== 首次启动：种子管理员可登录密码 ==========
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_USERNAME=kuangjun

# ========== 阿里云 OSS（可选；不填则 OSS 上传能力关闭）==========
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
ALIYUN_OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com

# ========== 公网访问基址（按实际部署修改）==========
JEWELRY_PUBLIC_BASE_URL=http://localhost:8851
# B2B_PUBLIC_BASE_URL=http://localhost:8852

# 客户进度页：管理端 SPA 根地址（Docker 开发见 frontend-admin 映射端口 3000）。后端会生成 {此值}/#/order-status/{token}
JEWELRY_CUSTOMER_ORDER_FRONTEND_URL=http://localhost:3000
# 若静态站用 BrowserRouter 且无 #，设为 false
# JEWELRY_CUSTOMER_ORDER_USE_HASH_ROUTING=true
