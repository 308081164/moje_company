# ================================================
# MOJE 珠宝 - 生产环境配置模板
# 使用前请复制为 .env 并填入实际配置
# ================================================

# 数据库配置
MYSQL_PASSWORD=your_strong_mysql_password_here

# JWT配置
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# 阿里云OSS配置
ALIYUN_OSS_ACCESS_KEY=your_aliyun_access_key
ALIYUN_OSS_SECRET_KEY=your_aliyun_secret_key
ALIYUN_OSS_BUCKET=moje-jewelry-oss
ALIYUN_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com  # 根据你的区域修改

# 域名配置
DOMAIN_NAME=moje珠宝.com
WWW_DOMAIN_NAME=www.moje珠宝.com
ADMIN_EMAIL=admin@moje珠宝.com

# SSL配置（可选）
# 证书会通过Let's Encrypt自动申请，无需手动配置
# 但需要确保域名已正确解析到服务器

# 其他配置
# SPRING_PROFILES_ACTIVE=prod
